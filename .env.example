# Public site URL - used for sitemap/robots/OG metadata and metadataBase.
# Update this once the real domain is purchased; duckdns works fine until then.
NEXT_PUBLIC_SITE_URL=https://nyazulansari.duckdns.org

# Phase 4b - GitHub live metrics (built, see lib/github-metrics.ts). Fine-grained
# PAT, read-only, public-metadata scope, explicit expiration set. Never commit
# the real value. Without it, the site falls back to lib/github-metrics-fallback.json
# (or an honest "unavailable" state if that hasn't been seeded yet - see
# scripts/generate-github-snapshot.mjs / `npm run github:snapshot`).
GITHUB_TOKEN=

# Contact form email - used by app/api/contact/route.ts to actually send
# messages via Resend. Without it the route only validates + logs (the form
# still returns ok, nothing is emailed) - never commit the real value.
RESEND_API_KEY=

# Kill switches (see PRD Section 12).
# Particles: Phase 3, built - flip to true to enable, false to instantly
# disable in production without a code rollback if it ever misbehaves.
NEXT_PUBLIC_ENABLE_PARTICLES=true
# 3D visualizer: Phase 4a, built and committed (see README).
NEXT_PUBLIC_ENABLE_3D_VIZ=true
